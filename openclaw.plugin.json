{
  "id": "openclaw-promptlayer",
  "kind": "observability",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiKey": {
        "type": "string",
        "description": "PromptLayer API key. Falls back to PROMPTLAYER_API_KEY env var."
      },
      "endpoint": {
        "type": "string",
        "default": "https://api.promptlayer.com/v1/traces",
        "description": "PromptLayer OTLP/HTTP traces endpoint."
      },
      "environment": {
        "type": "string",
        "default": "development",
        "description": "Deployment environment label."
      },
      "serviceName": {
        "type": "string",
        "default": "openclaw-agent",
        "description": "OTEL service name for resource identification."
      },
      "providerName": {
        "type": "string",
        "description": "Default GenAI provider name, e.g. openai or anthropic."
      },
      "providerNameMap": {
        "type": "object",
        "additionalProperties": { "type": "string" },
        "default": {},
        "description": "Map OpenClaw provider ids to OTEL provider names."
      },
      "resourceAttributes": {
        "type": "object",
        "additionalProperties": { "type": "string" },
        "description": "Additional OTEL resource attributes."
      },
      "spanProcessorType": {
        "type": "string",
        "enum": ["batch", "simple"],
        "default": "batch",
        "description": "Span processor type. Use simple for exporter debugging."
      },
      "batchConfig": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxQueueSize": { "type": "integer", "default": 2048 },
          "maxExportBatchSize": { "type": "integer", "default": 512 },
          "scheduledDelayMs": { "type": "integer", "default": 5000 }
        }
      }
    }
  },
  "uiHints": {
    "apiKey": {
      "label": "API Key",
      "placeholder": "Set via PROMPTLAYER_API_KEY env var",
      "sensitive": true
    },
    "endpoint": {
      "label": "OTLP Endpoint",
      "placeholder": "https://api.promptlayer.com/v1/traces"
    },
    "environment": {
      "label": "Environment",
      "placeholder": "production"
    },
    "serviceName": {
      "label": "Service Name",
      "placeholder": "openclaw-agent"
    }
  }
}
